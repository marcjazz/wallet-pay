# syntax=docker.io/docker/dockerfile:1
FROM node:current-alpine3.21 AS deps

# #set the working directory
WORKDIR /app

# # install app dependencies
COPY package*.json ./

# clean install dependecies
RUN --mount=type=cache,target=/app/node_modules \ 
    npm ci --verbose

FROM deps AS builder
WORKDIR /app

RUN --mount=type=cache,target=/app/node_modules \
    --mount=type=bind,src=./prisma,target=/app/prisma \
    cp -R ./node_modules /app/node_modules \
    cp -R ./prisma /app/prisma

COPY --from=deps /app/package*.json ./
COPY --from=deps /app/node_modules ./node_modules
COPY ./apps/wallet-api ./apps/wallet-api
COPY ./prisma ./prisma

# Migrate prisma models
RUN npx prisma generate

# Build backend app
RUN npx nx build wallet-api

FROM builder AS runner
WORKDIR /app

# Use a non-root user for securityRUN addgroup -S nodejs && adduser -S nestjs -G nodejs
USER nestjs

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist/apps/wallet-api ./dist
COPY --from=builder /app/prisma ./dist/prisma

# # expose port 5000 to outer environment
EXPOSE 5000

# run app
CMD ["npm", "run", "start:prod"]
