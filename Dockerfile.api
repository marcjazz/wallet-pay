# syntax=docker.io/docker/dockerfile:1
FROM node:23-alpine3.21 AS base

LABEL maintainer="Marco Kuidja <kuidjamarco@gmail.com>"
LABEL org.opencontainers.image.description="NestJs backend for the XafPay Wallet"

# #set the working directory
WORKDIR /app

FROM base AS deps
# clean install dependecies
RUN --mount=type=cache,target=/app/node_modules \ 
    --mount=type=bind,src=package.json,target=/app/package.json \ 
    --mount=type=bind,src=package-lock.json,target=/app/package-lock.json \ 
    npm ci \
    && cp -R /app/node_modules /app/deps

FROM base AS builder

COPY --from=deps /app/deps ./node_modules

# Build nestjs project
RUN --mount=type=bind,src=package.json,target=/app/package.json \ 
    --mount=type=bind,src=package-lock.json,target=/app/package-lock.json \ 
    --mount=type=bind,src=tsconfig.base.json,target=/app/tsconfig.base.json \ 
    --mount=type=bind,src=nx.json,target=/app/nx.json \ 
    --mount=type=bind,src=./prisma,target=/app/prisma \ 
    --mount=type=bind,src=./apps/wallet-api,target=/app/apps/wallet-api \ 
    --mount=type=bind,src=peex-openapi.yaml,target=/app/peex-openapi.yaml \
    --mount=type=cache,target=/app/node_modules \ 
    --mount=type=cache,target=/app/dist \
    # Generate prisma client
    npx prisma generate \
    # Generate openapi docs
    && npx openapi-typescript-codegen \
    --input ./peex-openapi.yaml \
    --output ./apps/wallet-api/src/peex/peex-client \
    --client axios \
    # Disable nx cloud & Build backend app
    && NX_CLOUD=0 npx nx run wallet-api:build:production \
    && cp -R /app/dist/apps/wallet-api ./final_dist \
    # Prune node_modules to project specific deps
    && npm ci --omit=dev --prefix /app/dist/apps/wallet-api \
    && cp -R /app/dist/apps/wallet-api/node_modules /app/final_dist/node_modules \
    && cp -R /app/prisma /app/final_dist/prisma \
    # Regenerating prisma client
    && cd /app/final_dist \
    && npx prisma generate

FROM base AS runner

ENV NODE_ENV=production
ENV PORT=5000

# Use a non-root user for security
RUN addgroup -S -g 1001 nodejs && adduser -S nestjs -G nodejs -u 1001

COPY entrypoint.sh ./entrypoint.sh

COPY --from=builder --chown=nestjs:nodejs /app/final_dist ./

RUN chmod +x entrypoint.sh

# switch to non-root user
USER nestjs

# # expose port 5000 to outer environment
EXPOSE 5000

# run app
CMD ["./entrypoint.sh"]