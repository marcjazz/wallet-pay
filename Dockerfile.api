FROM node:20-alpine3.17 AS builder

# #set the working directory
WORKDIR /app

# # install app dependencies
COPY package*.json ./

# #clean install dependecies
RUN npm install --force

# COPY workspace configs
COPY ./tsconfig.base.json ./
COPY ./nx.json ./

# COPY REQUIRED LIBS AND CONCERNED APP
COPY ./apps/wallet-api ./apps/wallet-api
COPY ./apps/wallet-api/src/prisma ./prisma

#migrate prisma models
RUN npx prisma generate

# #build backend app
RUN npx nx run wallet-api:build:production

# #provide schema for build usage
RUN rm -r ./apps/wallet-api/src/prisma/db
COPY ./apps/wallet-api/src/prisma ./dist/apps/wallet-api

# #DELETE SOURCE CODE FROM CONTAINER
# RUN rm -r ./apps
RUN rm nx.json
# RUN rm package.json
RUN rm package-lock.json
RUN rm tsconfig.base.json
RUN rm -r ./prisma

# # expose port 5000 to outer environment
EXPOSE 5000

# run app
WORKDIR /app/dist/apps/wallet-api
CMD ["node", "main.js"]
