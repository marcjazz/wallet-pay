FROM node:20-alpine

#set the working directory
WORKDIR /app

# install app dependencies
COPY package*.json ./

#clean install dependecies
RUN npm install --force

# COPY workspace configs
COPY ./tsconfig.base.json ./
COPY ./nx.json ./

# COPY REQUIRED LIBS AND CONCERNED APP
COPY ./apps/wallet-api ./apps/wallet-api

# build wallet api
RUN npx nx run wallet-api:build:production

# #DELETE SOURCE CODE FROM CONTAINER
# RUN rm -r ./apps
# RUN rm -r ./libs
# RUN rm nx.json
# RUN rm package.json
# RUN rm package-lock.json
# RUN rm tsconfig.base.json

# expose port 3000 to outer environment
EXPOSE 5000

# run app
CMD ["./entry.sh"]
