{
  "name": "wallet-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/wallet-api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/wallet-api",
        "main": "apps/wallet-api/src/main.ts",
        "tsConfig": "apps/wallet-api/tsconfig.app.json",
        "generatePackageJson": true,
        "assets": [
          "apps/wallet-api/src/assets"
        ],
        "webpackConfig": "apps/wallet-api/webpack.config.js"
      },
      "configurations": {
        "development": {},
        "production": {},
        "test": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "wallet-api:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "wallet-api:build:development"
        },
        "test": {
          "buildTarget": "wallet-api:build:test"
        },
        "production": {
          "buildTarget": "wallet-api:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/wallet-api/jest.config.ts"
      }
    },
    "swagger": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx openapi-typescript http://localhost:5000/docs-yaml --output libs/api/data-types/api-docs.ts"
        ]
      }
    }
  },
  "tags": []
}